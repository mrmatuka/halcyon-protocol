{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "stats": {
        "type": "object",
        "properties": {
          "eletero": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["eletero"],
        "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "options": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "autoSuccess"
                    },
                    "stats": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      }
                    },
                    "choiceIds": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      }
                    }
                  },
                  "required": ["type", "stats"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "reroll"
                    },
                    "stats": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      }
                    }
                  },
                  "required": ["type", "stats"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "heal"
                    },
                    "amount": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["type", "amount"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["id", "name", "description", "options"],
        "additionalProperties": false
      },
      "portrait": {
        "type": "string",
        "maxLength": 100000,
        "pattern": "^(?:preset:(?:scout|scholar|guardian|mediator)-[12]|data:image\\/jpeg;base64,[a-z0-9+/=]+)$"
      }
    },
    "required": ["id", "name", "role", "description", "stats", "card"],
    "additionalProperties": false
  }
}
